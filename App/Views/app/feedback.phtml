    <script>
    document.getElementById('form-feedback').addEventListener('submit', function(e) {
        const titulo = document.getElementById('titulo').value.trim();
        const sugestao = document.getElementById('sugestao').value.trim();
        
        if (!titulo) {
            e.preventDefault();
            stockManager.showNotification('Por favor, preencha o título', 'error');
            return;
        }
        
        if (!sugestao) {
            e.preventDefault();
            stockManager.showNotification('Por favor, preencha sua mensagem', 'error');
            return;
        }
        
        if (sugestao.length < 10) {
            e.preventDefault();
            stockManager.showNotification('Sua mensagem deve ter pelo menos 10 caracteres', 'warning');
            return;
        }
        
        stockManager.showNotification('Enviando feedback...', 'info');
    });
    </script>
