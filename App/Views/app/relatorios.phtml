<script>
// Função para abrir o modal de exportação
function abrirModalExportar() {
    $('#modalExportar').modal('show');
}

// Se quiser abrir o modal automaticamente ao clicar no botão de exportar
document.addEventListener('DOMContentLoaded', function() {
    let btnExportar = document.querySelector('a[href="/exportar-relatorio"]');
    if (btnExportar) {
        btnExportar.addEventListener('click', function(e) {
            e.preventDefault();
            abrirModalExportar();
        });
    }
});
</script>

